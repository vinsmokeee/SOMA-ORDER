rules_version = '2';
// Only the SOMA accounts listed below can read or change orders.
// Replace the two values with the User UIDs from Firebase console → Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSoma() {
      return request.auth != null && request.auth.uid in [
        'OWNER_UID',
        'HELPER_UID'
      ];
    }
    match /orders/{orderId} {
      allow read, write: if isSoma();
    }
    match /settings/{docId} {
      allow read, write: if isSoma();
    }
  }
}
